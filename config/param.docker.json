{
  "annotation": {
    "docker": {
      "entries": {
        "vep": {
          "tool": "vep",
          "update_existing_fields": false,
          "parameters": [
            "--everything",
            {
              "key": "--max_sv_size",
              "value": "1000000"
            }
          ]
        }
      },
      "entries_examples": {
        "vep": {
          "tool": "vep",
          "update_existing_fields": true,
          "where_clause": " WHERE \"#CHROM\" != 'chr7' "
        },
        "vep_chr7": {
          "tool": "vep",
          "parameters": [
            "--everything",
            {
              "key": "--max_sv_size",
              "value": "1000000"
            }
          ],
          "output_pattern": "*.vcf.gz",
          "where_clause": " WHERE \"#CHROM\" = 'chr7' "
        }
      }
    }
  }
}
