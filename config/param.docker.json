{
  "annotation": {
    "docker": {
      "entries": {
        "vep": {
          "tool": "vep",
          "command": "vep",
          "primary": {
            "input": "--input_file",
            "output": "--output_file",
            "threads": "--fork"
          },
          "resources": {
            "threads": 4,
            "memory": null
          },
          "databases": [
            {
                "name": "vep",
                "container_path": "/opt/vep/.vep",
                "mode": "ro"
            }
          ],
          "parameters": [
            "--vcf",
            "--cache",
            "--offline",
            {
              "key": "--assembly",
              "value": "GRCh37"
            },
            {
              "key": "--compress_output",
              "value": "bgzip"
            },
            "--force_overwrite"
          ],
          "output_pattern": "*.vcf.gz",
          "remove_info": true,
          "add_samples": true,
          "update_header": true,
          "where_clause": " WHERE \"#CHROM\" = 'chr7' "
        }
      }
    }
  },
  "threads": 8
}
